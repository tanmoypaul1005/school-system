generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(STUDENT)
  isEmailVerified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  otps      UserOtp[]
  courseAssignments CourseAssign[]
}

model UserOtp {
  id        String   @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SUB_ADMIN

  STUDENT
  TEACHER

  PRINCIPAL
  VICE_PRINCIPAL
  COORDINATOR

  ACCOUNTANT
  LIBRARIAN
  RECEPTIONIST

  GUARDIAN
  PARENT

  STAFF
  EMPLOYEE

  EXAMINER

  DRIVER

  HR
}

model Class {
  id          String    @id @default(uuid())
  name        String
  numericName Int? // Example: 1,2,3...

  sections    Section[]
  courseAssignments CourseAssign[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name])
}

model Course {
  id        String   @id @default(uuid())
  name      String
  code      String?

  courseAssignments CourseAssign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code])
}

model Section {
  id          String    @id @default(uuid())
  name        String // Example: A, B, C

  classId     String
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  courseAssignments CourseAssign[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, classId])
}

model CourseAssign {
  id        String   @id @default(uuid())
  courseId  String
  classId   String
  sectionId String?
  teacherId String
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean  @default(true)

  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  class    Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  section  Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  teacher  User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([classId])
  @@index([sectionId])
  @@index([teacherId])
  @@unique([courseId, classId, sectionId, teacherId])
}

model ClassSlot {
  id        String   @id @default(uuid())
  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}